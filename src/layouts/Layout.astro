---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Federal Technology Partner specializing in Software Development, Data Analytics, and Predictive AI/ML Logistics." } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

        <!-- Google Fonts Imports for JetBrains Mono -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<nav class="nav-container">
			<div class="nav-content">
				<a href="/" class="brand-logo">ARKBRIDGE <span class="brand-accent">SYSTEMS</span></a>
				<div class="nav-links">
					<a href="#competencies">Capabilities</a>
					<a href="#corporate-data">Corporate Data</a>
					<a href="#differentiators">Differentiators</a>
					<a href="#contact" class="btn-primary">Contact / RFIs</a>
				</div>
			</div>
		</nav>
		
		<main class="main-content">
			<slot />
		</main>

		<footer class="footer-container">
			<div class="footer-content">
				<p>&copy; {new Date().getFullYear()} Arkbridge Systems LLC. All Rights Reserved.</p>
				<p class="footer-disclaimer">An Equal Opportunity Technical Services Provider.</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--navy-primary: #0f172a;
		--navy-light: #1e293b;
		--accent-blue: #2563eb;
		--text-main: #334155;
		--text-light: #f8fafc;
		--border-color: #cbd5e1;
		--max-width: 1200px;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		color: var(--navy-primary);
		background-color: #ffffff;
		line-height: 1.6;
	}

	.nav-container {
		background-color: var(--navy-primary);
		border-bottom: 2px solid var(--accent-blue);
		position: sticky;
		top: 0;
		z-index: 100;
	}

	.nav-content {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 1rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.brand-logo {
		font-family: 'JetBrains Mono', 'Fira Code', monospace; /* Modern engineering look */
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: 0.15em; /* Breathing room for premium branding */
		text-transform: uppercase;
		color: #ffffff;
		text-decoration: none;
	}
		
	.brand-accent {
		color: #3b82f6; /* Sharp blue (or your specific brand theme color) */
	}

	.text-mute {
		color: var(--border-color);
		font-weight: 300;
	}

	.nav-links a {
		color: #ffffff;
		text-decoration: none;
		margin-left: 2rem;
		font-size: 0.95rem;
		font-weight: 500;
	}

	.nav-links a:hover {
		color: var(--border-color);
	}

	.nav-links .btn-primary {
		background-color: var(--accent-blue);
		padding: 0.5rem 1rem;
		border-radius: 4px;
		transition: background-color 0.2s ease;
	}

	.nav-links .btn-primary:hover {
		background-color: #1d4ed8;
		color: #ffffff;
	}

	.main-content {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 3rem 2rem;
	}

	.footer-container {
		background-color: #f1f5f9;
		border-top: 1px solid var(--border-color);
		margin-top: 5rem;
		padding: 2rem 0;
		font-size: 0.85rem;
		color: var(--text-main);
	}

	.footer-content {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		justify-content: space-between;
	}

	@media (max-width: 768px) {
		.nav-content, .footer-content {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}
		.nav-links a {
			margin: 0 0.5rem;
		}
	}
</style>
